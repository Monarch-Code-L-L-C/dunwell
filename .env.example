# Copy to .env. Nothing here is required to run locally.

# Public URL of the site, no trailing slash.
BASE_URL=http://localhost:3000
PORT=3000

# Local inspection only: treats every visitor as Pro. Ignored when NODE_ENV=production.
DEV_UNLOCK=1

# --- Payments (Paddle Billing) ---
# PADDLE_ENV=sandbox                  # sandbox (default) or production
# PADDLE_API_KEY=                     # server-side API key. Secret.
# PADDLE_CLIENT_TOKEN=                # client-side token (test_... in sandbox, live_... in production). Public.
# PADDLE_PRICE_MONTHLY=pri_...        # recurring, EUR 9 / month
# PADDLE_PRICE_YEARLY=pri_...         # optional, recurring, EUR 79 / year
# Long random string; signs the Pro cookie. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# SESSION_SECRET=

# --- AI tailoring (optional) ---
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5
